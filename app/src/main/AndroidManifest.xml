<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="in.ecomexpress.sruti">

    <uses-sdk tools:overrideLibrary="esper.library" />

    <queries>
        <package android:name="io.shoonya.shoonyadpc" />
    </queries>

    <uses-feature
        android:name="android.hardware.camera"
        android:required="true" />
    <uses-feature
        android:name="android.hardware.camera.autofocus"
        android:required="false" />

    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.GET_ACCOUNTS" />
    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <uses-permission android:name="android.permission.READ_SMS" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <uses-permission android:name="android.permission.SEND_SMS" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <uses-permission android:name="android.permission.WRITE_CALL_LOG" />

    <uses-feature android:name="android.hardware.camera.flash" />

    <application
        android:name=".SrutiApplication"
        android:allowBackup="true"
        android:hardwareAccelerated="true"
        android:icon="@drawable/new_ecom_logo"
        android:label="@string/app_name"
        android:largeHeap="true"
        android:theme="@style/AppTheme">
        <activity
            android:name=".ui.dashboard.training.TrainingActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize"/>
        <activity
            android:name=".utils.MultiSpaceCheck.MultiSpaceActivity"
            android:excludeFromRecents="true"
            android:launchMode="singleInstance"
            android:theme="@android:style/Theme.Dialog" />
        <activity
            android:name=".ui.dashboard.shipment.ShipmentSignatureActivity"
            android:exported="false" />
        <activity
            android:name=".ui.dashboard.shipment.ShipmentOtpActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustPan" />
        <activity
            android:name=".ui.dashboard.reasoncode.ManifestStatusActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".ui.login.login.LoginActivity"
            android:configChanges="keyboardHidden"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize|stateAlwaysHidden">

            <!-- <queries> -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- </queries> -->
        </activity>
        <activity
            android:name=".ui.dashboard.todolist.todoactivitymodel.ToDoListActivity"
            android:launchMode="singleTask"
            android:screenOrientation="portrait" />
        <activity
            android:name=".ui.dashboard.seller.seller_activity_model.SellerActivity"
            android:screenOrientation="portrait" />
        <activity
            android:name=".ui.dashboard.warehouse.warehouse_activity_model.WarehouseActivity"
            android:screenOrientation="portrait" />
        <activity
            android:name=".ui.dashboard.fuel.FuelReimburseActivity"
            android:screenOrientation="portrait" />
        <activity
            android:name=".ui.dashboard.performance.PerformanceActivity"
            android:screenOrientation="portrait" />
        <activity
            android:name=".ui.dashboard.dashboard_main.dashboard_activity_model.DashboardActivity"
            android:screenOrientation="portrait" /> <!-- PROFILE -->
        <activity
            android:name=".ui.dashboard.profile.ProfileActivity"
            android:screenOrientation="portrait" />
        <activity
            android:name=".ui.login.verifyOtpLoginScreen.LoginVerifyOtpActivity"
            android:configChanges="keyboardHidden"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize|stateHidden" />
        <activity
            android:name=".ui.dashboard.attendence.AttendanceActivityView"
            android:screenOrientation="portrait" />
        <activity
            android:name=".ui.dashboard.globalscan.GlobalScanScreenActivity"
            android:screenOrientation="portrait" />
        <activity
            android:name=".ui.dashboard.globalscansummary.GlobalManifestSummaryActivity"
            android:screenOrientation="portrait" />
        <activity
            android:name=".ui.dashboard.handover.HandOverScanActivity"
            android:screenOrientation="portrait" />
        <activity
            android:name=".ui.dashboard.handover.HandOverDetailActivity"
            android:screenOrientation="portrait" />
        <activity
            android:name=".ui.dashboard.globalscansummary.GlobalShipmentListActivity"
            android:screenOrientation="portrait" /> <!-- <meta-data -->
        <!-- android:name="com.google.android.maps.v2.API_KEY" -->
        <!-- android:value="@string/google_maps_key" /> -->
        <!-- <meta-data -->
        <!-- android:name="com.google.android.gms.version" -->
        <!-- android:value="@integer/google_play_services_version" /> -->
        <!--  -->
        <activity
            android:name=".ui.dashboard.signature.SignatureActivity"
            android:screenOrientation="portrait" />
        <activity
            android:name=".ui.dashboard.todolist.todoactivitymodel.RecciQuestion"
            android:screenOrientation="portrait" />
        <activity
            android:name=".ui.dashboard.seller.seller_activity_model.SellerScanActivity"
            android:screenOrientation="portrait" />
        <activity
            android:name=".ui.dashboard.warehouse.warehouse_activity_model.WarehouseScanActivity"
            android:screenOrientation="portrait" />
        <activity
            android:name=".ui.dashboard.handover.HandOverListActivity"
            android:screenOrientation="portrait" />
        <activity android:name=".ui.dashboard.starttrip.NewImage" />
        <activity
            android:name=".ui.dashboard.signature.SuccessFailActivity"
            android:screenOrientation="portrait"
            tools:replace="screenOrientation" />
        <activity
            android:name=".ui.dashboard.todolist.todoactivitymodel.OtpVerificationActivity"
            android:screenOrientation="portrait"
            tools:replace="screenOrientation" />
        <activity
            android:name=".ui.dashboard.todolist.todoactivitymodel.QrcReaderActivity"
            android:screenOrientation="portrait"
            tools:replace="screenOrientation" />
        <activity
            android:name=".ui.dashboard.reasoncode.OtpReasonCodeActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustNothing" />
        <activity
            android:name=".ui.dashboard.reasoncode.ManifestLevelReasonCodeActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name="com.journeyapps.barcodescanner.CaptureActivity"
            android:screenOrientation="portrait"
            android:stateNotNeeded="true"
            android:windowSoftInputMode="stateAlwaysHidden"
            tools:replace="android:screenOrientation" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <service android:name=".background_service.SrutiSyncService" />
        <service android:name=".background_service.GPSTracker" />
        <service android:name=".utils.MyIntentService" />
    </application>

</manifest>