<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <!-- Customize your theme here. -->
        <item name="android:windowContentOverlay">@null</item>
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="android:textColorPrimary">@color/gray</item>
        <item name="android:textColor">@color/gray</item>
        <item name="android:windowBackground">@color/bg_color</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="android:typeface">sans</item>
        <item name="drawerArrowStyle">@style/MaterialDrawer.DrawerArrowStyle</item>
        <item name="android:textAppearance">@style/TextAppearance.Text.Regular</item>
    </style>

    <style name="AppTheme.DialogTheme" parent="Base.Theme.AppCompat.Light.Dialog.FixedSize">
        <!-- removing the dialog's action bar -->
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="AppFullScreenTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>

    <style name="AppTheme1" parent="Theme.AppCompat.Light.NoActionBar">
        <!-- Customize your theme here. -->
        <item name="android:windowContentOverlay">@null</item>
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="android:textColorPrimary">@color/gray</item>
        <item name="android:textColor">@color/gray</item>
        <item name="android:windowBackground">@color/white</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="android:typeface">sans</item>
        <item name="drawerArrowStyle">@style/MaterialDrawer.DrawerArrowStyle</item>
        <item name="android:textAppearance">@style/TextAppearance.Text.Regular</item>
    </style>

    <style name="MyProgressBarTwo" parent="@style/Widget.AppCompat.ProgressBar.Horizontal"></style>

    <style name="AppCompatAlertDialogStyle" parent="Theme.AppCompat.Light.Dialog.Alert">
        <item name="colorAccent">@color/colorAccent1</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/colorAccent1</item>
        <item name="android:textColorPrimary">@color/black</item>
        <item name="android:background">@color/white</item>
    </style>

    <style name="MatchSpinnerTheme" parent="AppTheme">
        <item name="android:colorBackground">@color/del2</item>
        <item name="android:itemBackground">@color/del1</item>
        <item name="android:textColor">@color/colorPrimaryDark</item>
        <item name="android:textSize">12sp</item>
        <item name="android:padding">2dp</item>
        <item name="android:dropDownListViewStyle">@style/MatchSpinnerStyle</item>
    </style>

    <style name="MatchSpinnerThemeEds" parent="AppTheme">
        <item name="android:colorBackground">@color/edslight</item>
        <item name="android:itemBackground">@color/edslight</item>
        <item name="android:textColor">@color/edstool</item>
        <item name="android:dropDownListViewStyle">@style/MatchSpinnerStyleeds</item>
    </style>

    <style name="MatchSpinnerStyleeds" parent="android:style/Widget.ListView.DropDown">
        <item name="android:divider">@color/edstool</item>
        <item name="android:textColor">@color/edstool</item>
        <item name="android:colorBackground">@color/edslight</item>
        <item name="android:itemBackground">@color/edslight</item>
        <item name="android:background">@color/edslight</item>
        <item name="android:dividerHeight">1dp</item>
    </style>

    <style name="MatchSpinnerStyle" parent="android:Widget.Spinner">
        <item name="android:divider">@color/colorPrimaryDark</item>
        <item name="android:textColor">@color/colorPrimaryDark</item>
        <item name="android:colorBackground">@color/del1</item>
        <item name="android:itemBackground">@color/del1</item>
        <item name="android:padding">10dp</item>
        <item name="android:background">@color/del1</item>
        <item name="android:dividerHeight">1dp</item>
    </style>

    <style name="AppTheme.AppBarOverlay" parent="ThemeOverlay.AppCompat.Dark.ActionBar" />

    <style name="AppTheme.PopupOverlay" parent="ThemeOverlay.AppCompat.Light" />

    <style name="CustomFontStyle">
        <item name="android:layout_width">fill_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:capitalize">characters</item>
        <item name="android:typeface">monospace</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textColor">@color/colorPrimaryDark</item>/>
    </style>

    <style name="AppThemeFullScreen" parent="AppTheme">
        <item name="colorPrimary">@color/white</item>
        <item name="colorPrimaryDark">@color/white</item>
        <item name="android:windowBackground">@color/white</item>
    </style>

    <style name="MaterialDrawer.DrawerArrowStyle" parent="Widget.AppCompat.DrawerArrowToggle">
        <item name="spinBars">false</item>
        <item name="color">@color/white</item>
    </style>

    <style name="TextAppearance.Text.Regular" parent="android:TextAppearance"></style>

    <style name="TextAppearance.Text.Bold" parent="android:TextAppearance"></style>

    <style name="TextAppearance.Text.Light" parent="android:TextAppearance"></style>

    <style name="TextAppearance.Text.Italic" parent="android:TextAppearance"></style>

    <style name="TextStyle">
        <item name="android:layout_marginTop">2dp</item>
        <item name="android:layout_marginBottom">2dp</item>
        <item name="android:layout_marginLeft">2dp</item>
        <item name="android:layout_marginRight">2dp</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="TextStyle.Title.Blue" parent="TextStyle">
        <item name="android:textSize">18sp</item>
        <item name="android:textAppearance">@style/TextAppearance.Text.Regular</item>
        <item name="android:textColor">@color/colorPrimaryDark</item>
    </style>

    <style name="TextStyle.Title.Sub" parent="TextStyle.Title.Blue">
        <item name="android:textAppearance">@style/TextAppearance.Text.Light</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:textColorHint">@color/gray</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="TextStyle.Heading" parent="TextStyle">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/colorPrimaryDark</item>
        <item name="android:textAppearance">@style/TextAppearance.Text.Bold</item>
    </style>

    <style name="TextStyle.Comment" parent="TextStyle">
        <item name="android:textSize">16sp</item>
        <item name="android:textAppearance">@style/TextAppearance.Text.Italic</item>
    </style>

    <style name="Toolbar" parent="Base.ThemeOverlay.AppCompat.Dark.ActionBar">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:elevation" tools:ignore="NewApi">10px</item>
        <item name="android:textSize">13sp</item>
        <item name="android:minHeight">?attr/actionBarSize</item>
        <item name="android:background">@color/colorBackground</item>
    </style>

    <style name="DrawerArrowStyle" parent="@style/Widget.AppCompat.DrawerArrowToggle">
        <item name="spinBars">true</item>
        <item name="color">@color/colorAccent1</item>
    </style>

    <style name="Toolbar.TitleText" parent="TextStyle.Heading">
        <item name="android:textColor">@color/colorPrimaryDark</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="SearchViewStyle" parent="Widget.AppCompat.SearchView">
        <item name="queryBackground">@android:color/white</item>
        <item name="searchHintIcon">@color/colorPrimaryDark</item>
        <item name="iconifiedByDefault">false</item>
        <item name="android:cursorVisible">true</item>
        <item name="colorControlActivated">@color/colorPrimaryDark</item>
        <item name="colorControlNormal">@color/colorPrimaryDark</item>
        <item name="colorControlHighlight">@color/colorPrimaryDark</item>
        <item name="android:textColor">@color/colorPrimaryDark</item>
        <item name="android:textColorHint">@android:color/darker_gray</item>
        <item name="queryHint">@string/search_hint</item>
    </style>

    <style name="shipmentSearch" parent="Widget.AppCompat.SearchView">
        <item name="queryBackground">@android:color/white</item>
        <item name="searchHintIcon">@color/colorPrimaryDark</item>
        <item name="iconifiedByDefault">false</item>
        <item name="android:cursorVisible">true</item>
        <item name="colorControlActivated">@color/colorPrimaryDark</item>
        <item name="colorControlNormal">@color/colorPrimaryDark</item>
        <item name="colorControlHighlight">@color/colorPrimaryDark</item>
        <item name="android:textColor">@color/colorPrimaryDark</item>
        <item name="android:textColorHint">@android:color/darker_gray</item>
        <item name="queryHint">@string/search_shipment</item>
    </style>

    <style name="SearchViewRTSStyle" parent="Widget.AppCompat.SearchView">
        <item name="queryBackground">@android:color/white</item>
        <item name="searchHintIcon">@color/colorPrimaryDark</item>
        <item name="iconifiedByDefault">false</item>
        <item name="android:cursorVisible">true</item>
        <item name="colorControlActivated">@color/colorPrimaryDark</item>
        <item name="colorControlNormal">@color/colorPrimaryDark</item>
        <item name="colorControlHighlight">@color/colorPrimaryDark</item>
        <item name="android:textColor">@color/colorPrimaryDark</item>
        <item name="android:textColorHint">@android:color/darker_gray</item>
        <item name="queryHint">@string/search_awb</item>
    </style>

    <style name="RtsSearchViewStyle" parent="Widget.AppCompat.SearchView">
        <item name="queryBackground">@android:color/white</item>
        <item name="searchHintIcon">@color/pickuptool</item>
        <item name="iconifiedByDefault">false</item>
        <item name="android:cursorVisible">true</item>
        <item name="colorControlActivated">@color/pickuptool</item>
        <item name="colorControlNormal">@color/pickuptool</item>
        <item name="colorControlHighlight">@color/pickuptool</item>
        <item name="android:textColor">@color/pickuptool</item>
        <item name="android:textColorHint">@android:color/darker_gray</item>
        <item name="queryHint">@string/search_awb</item>
    </style>

    <style name="Button" parent="Widget.AppCompat.Button">
        <item name="android:textColor">@color/black_effective</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:paddingLeft">8dp</item>
        <item name="android:paddingRight">8dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="android:foreground">?selectableItemBackground</item>
    </style>

    <style name="Button.ImageView" parent="Widget.AppCompat.ImageButton">
        <item name="android:padding">5dp</item>
        <item name="android:scaleType">centerInside</item>
        <item name="android:background">@null</item>
    </style>

    <style name="submitspinner" parent="Widget.AppCompat.Spinner">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:textColor">@color/gray</item>
        <item name="android:textSize">10sp</item>
    </style>

    <style name="TextAppearence.App.TextInputLayout" parent="@android:style/TextAppearance">
        <item name="android:textColor">@color/gray</item>
    </style>

    <style name="TextStyle.EditText" parent="TextStyle">
        <item name="android:textAppearance">@style/TextAppearance.Text.Regular</item>
    </style>

    <string name="search_hint">Search List</string>
    <string name="search_awb">Search AWB</string>

    <style name="NewDialog">
        <item name="android:windowFrame">@null</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowTitleStyle">@null</item>
        <item name="android:windowAnimationStyle">@android:style/Animation.Dialog</item>
        <item name="android:windowSoftInputMode">stateUnspecified|adjustPan</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:background">@android:color/transparent</item>
    </style>

    <string name="search_shipment">Search Shipment</string>

    <style name="videosheet" parent="@style/Widget.Design.BottomSheet.Modal">
        <item name="android:background">@drawable/video_round_corner</item>
    </style>

    <style name="videosheetDialog" parent="@style/Theme.Design.Light.BottomSheetDialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsFloating">false</item>
        <item name="bottomSheetStyle">@style/videosheet</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowSoftInputMode">adjustResize</item>
    </style>

    <style name="videosheetDialogTheme" parent="videosheetDialog" />

    <style name="PauseDialogAnimation">
        <item name="android:windowSoftInputMode">adjustResize</item>
        <item name="android:windowEnterAnimation">@anim/bottom_up</item>
        <item name="android:windowExitAnimation">@anim/bottom_down</item>
    </style>
</resources>
