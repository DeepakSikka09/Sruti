<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <import type="android.view.View" />

        <variable
            name="viewModel"
            type="in.ecomexpress.sruti.ui.dashboard.handover.HandOverDetailViewModel" />

    </data>

    <LinearLayout
        android:id="@+id/popup_element"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/colorBackground"
            android:elevation="10px">

            <ImageView
                android:id="@+id/back_event"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_centerVertical="true"
                android:layout_gravity="start"
                android:padding="@dimen/_10DP"
                android:tint="@color/colorPrimaryDark"
                app:srcCompat="@drawable/back" />

            <in.ecomexpress.sruti.utils.fonts.CustomTextBold
                style="@style/TextStyle.Title.Sub"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_weight="1"
                android:gravity="center"
                android:padding="@dimen/_15DP"
                android:text="@string/handover_summary"
                android:textColor="@color/colorPrimaryDark"
                android:textSize="15sp"
                android:textStyle="bold" />


            <ImageView
                android:id="@+id/download"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:background="@null"
                android:gravity="center"
                android:padding="@dimen/_5DP"
                app:srcCompat="@drawable/ic_viewby"
                tools:ignore="VectorDrawableCompat" />

            <in.ecomexpress.sruti.utils.fonts.CustomTextBold
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_gravity="end"
                android:layout_marginEnd="@dimen/_10DP"
                android:layout_marginRight="@dimen/_10DP"
                android:gravity="center|end"
                android:text="@string/v2_0_0"
                android:textColor="@color/colorAccent1"
                android:textSize="13sp" />

        </LinearLayout>

        <View
            android:id="@+id/view"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_below="@+id/toolbar"
            android:layout_gravity="center"
            android:background="@color/colorView"
            android:gravity="center" />

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!--CHILD ONE-->
            <LinearLayout
                android:id="@+id/layout_child"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_margin="@dimen/_2DP"
                android:background="@drawable/border"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="@dimen/_15DP"
                android:paddingBottom="@dimen/_1DP">


                <in.ecomexpress.sruti.utils.fonts.CustomTextBold
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="start"
                    android:layout_marginBottom="@dimen/_2DP"
                    android:layout_weight=".08"
                    android:gravity="center"
                    android:maxLines="2"
                    android:padding="@dimen/_1DP"
                    android:scrollbars="vertical"
                    android:text="@string/summary"
                    android:textColor="@color/colorPrimaryDark"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/_2DP"
                    android:orientation="horizontal">

                    <in.ecomexpress.sruti.utils.fonts.CustomTextBold
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_gravity="start"
                        android:layout_marginBottom="@dimen/_2DP"
                        android:layout_weight=".08"
                        android:gravity="start"
                        android:maxLines="2"
                        android:padding="@dimen/_1DP"
                        android:scrollbars="vertical"
                        android:text="@string/total_awb"
                        android:textColor="@color/colorText"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <in.ecomexpress.sruti.utils.fonts.CustomTextBold
                        android:id="@+id/txt_awb"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_gravity="end"
                        android:layout_marginBottom="@dimen/_2DP"
                        android:layout_weight=".02"
                        android:gravity="end"
                        android:padding="@dimen/_1DP"
                        android:textColor="@color/colorText"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                </LinearLayout>


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/_2DP"
                    android:orientation="horizontal">

                    <in.ecomexpress.sruti.utils.fonts.CustomTextBold
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_gravity="start"
                        android:layout_marginBottom="@dimen/_2DP"
                        android:layout_weight=".08"
                        android:gravity="start"
                        android:maxLines="2"
                        android:padding="@dimen/_1DP"
                        android:scrollbars="vertical"
                        android:text="@string/advance_shipment"
                        android:textColor="@color/colorText"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <in.ecomexpress.sruti.utils.fonts.CustomTextBold
                        android:id="@+id/txt_advance_shipment"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_gravity="end"
                        android:layout_marginBottom="@dimen/_2DP"
                        android:layout_weight=".02"
                        android:gravity="end"
                        android:padding="@dimen/_1DP"
                        android:text="0"
                        android:textColor="@color/colorText"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                </LinearLayout>


            </LinearLayout>
            <!--</android.support.v7.widget.CardView>-->


            <Button
                android:id="@+id/btn_submit"
                style="@style/TextStyle.Title.Sub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentBottom="true"
                android:layout_marginBottom="@dimen/_20DP"
                android:background="@drawable/generic_button"
                android:gravity="center"
                android:padding="@dimen/_10DP"
                android:text="@string/submit"
                android:textColor="@color/colorBackground"
                android:textSize="15sp"
                android:textStyle="bold" />

        </RelativeLayout>
    </LinearLayout>
</layout>