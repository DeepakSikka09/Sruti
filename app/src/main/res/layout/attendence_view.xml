<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>

        <import type="android.view.View" />

        <variable
            name="attendencemodel"
            type="in.ecomexpress.sruti.ui.dashboard.attendence.AttendenceViewModel" />
    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:elevation="10px"
            android:id="@+id/header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/colorBackground"
            android:orientation="horizontal"
            android:weightSum="4">


        <ImageView
                android:id="@+id/imageViewBack"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_gravity="start"
                android:padding="@dimen/_10DP"
                android:tint="@color/colorPrimaryDark"
                app:srcCompat="@drawable/back" />

            <in.ecomexpress.sruti.utils.fonts.CustomTextBold
                style="@style/TextStyle.Title.Sub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:padding="@dimen/_15DP"
                android:text="@string/attendance"
                android:textColor="@color/colorPrimaryDark"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>
        <View
            android:id="@+id/view"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_below="@+id/toolbar"
            android:layout_gravity="center"
            android:background="@color/colorView"
            android:gravity="center" />

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="50dp">

            <in.ecomexpress.sruti.utils.fonts.CustomTextBold
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="start|center"
                android:textColor="@color/colorPrimaryDark"
                android:layout_marginStart="@dimen/_20DP"
                android:layout_gravity="start"
                android:layout_centerVertical="true"
                android:layout_toLeftOf="@+id/attendence_month"
                android:text="Select Month"
                android:textSize="13sp"
                android:layout_marginLeft="@dimen/_20DP" />

            <Spinner
                android:id="@+id/attendence_month"
                android:layout_width="120dp"
                android:elevation="10px"
                android:layout_marginEnd="@dimen/_20DP"
                android:layout_height="match_parent"
                android:layout_alignParentRight="true"

                android:layout_centerVertical="true"
                android:layout_margin="@dimen/_10DP"
                android:background="@drawable/spinner_custom"
                android:entries="@array/type_of_veh"
                android:theme="@style/MatchSpinnerTheme"
                android:layout_marginRight="@dimen/_20DP" />
        </RelativeLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/weekdays_view"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginLeft="7dp"
            android:layout_marginRight="7dp"
            android:layout_marginTop="20dp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/attendance_recycleview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginLeft="7dp"
            android:layout_marginRight="7dp"
            android:layout_marginTop="5dp" />
    </LinearLayout>
</layout>