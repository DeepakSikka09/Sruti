<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/popup_element"
    android:layout_width="match_parent"

    android:layout_height="wrap_content"
    android:layout_margin="@dimen/_5DP"
    android:background="?android:attr/selectableItemBackground"
    android:orientation="horizontal">

    <androidx.cardview.widget.CardView
        android:layout_width="@dimen/_10DP"
        android:layout_height="match_parent"
        android:layout_marginBottom="@dimen/_5DP"
        android:layout_marginLeft="@dimen/_5DP"
        android:layout_marginStart="@dimen/_5DP"
        android:layout_marginTop="@dimen/_5DP"
        android:background="?android:attr/selectableItemBackground"
        android:focusable="true"
        app:cardBackgroundColor="@color/colorAccent1"
        app:cardCornerRadius="@dimen/_7DP"
        app:cardElevation="@dimen/_20DP"></androidx.cardview.widget.CardView>

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_margin="@dimen/_5DP"
        android:padding="@dimen/_20DP"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="@dimen/_7DP"
        app:cardElevation="@dimen/_10DP">

        <LinearLayout
            android:id="@+id/shipment_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/_5DP"
            android:background="@color/white"
            android:gravity="start"
            android:orientation="horizontal"
            android:padding="@dimen/_2DP">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight=".85"
                android:orientation="vertical">

                <in.ecomexpress.sruti.utils.fonts.CustomTextBold
                    android:id="@+id/awb_no"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Airwaybill No."
                    android:textColor="@color/colorPrimaryDark"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <in.ecomexpress.sruti.utils.fonts.CustomTextRegular
                    android:id="@+id/parent_awb_no"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1242626"
                    android:textColor="@color/colorText"
                    android:textSize="13sp" />


            </LinearLayout>

            <CheckBox
                android:id="@+id/checkbox_ckb"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_gravity="end"
                android:layout_weight=".15"
                android:buttonTint="@color/colorAccent1"
                android:gravity="center" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>
</LinearLayout>

