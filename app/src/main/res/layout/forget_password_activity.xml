<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:context="in.ecomexpress.sathi.ui.dashboard.forget.ForgetActivity">

    <data>

        <import type="android.view.View" />

        <variable
            name="viewModel"
            type="in.ecomexpress.sruti.ui.login.forget.ForgetViewModel" />
    </data>


    <LinearLayout
        android:id="@+id/popup_element"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="10dp"
            android:elevation="10px"
            app:cardBackgroundColor="@color/colorBackground"
            app:cardCornerRadius="@dimen/_7DP"
            app:cardElevation="@dimen/_25DP">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_margin="@dimen/_5DP"
                android:background="@color/colorBackground"
                android:orientation="vertical">

                <RelativeLayout
                    android:elevation="10px"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:background="@color/colorBackground"
                    android:gravity="center_vertical">

                    <in.ecomexpress.sruti.utils.fonts.CustomTextBold
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:layout_gravity="center"
                        android:layout_weight="0.1"
                        android:gravity="center"
                        android:padding="@dimen/_10DP"
                        android:text="Forgot Password"
                        android:textColor="@color/colorPrimaryDark"
                        android:textSize="15sp" />

                    <ImageView
                        android:id="@+id/cross"
                        android:layout_width="50dp"
                        android:layout_height="50dp"
                        android:layout_alignParentEnd="true"
                        android:layout_alignParentRight="true"
                        android:layout_gravity="end|right"
                        android:layout_weight="0.02"
                        android:onClick="@{() -> viewModel.onBackClick()}"
                        android:padding="@dimen/_10DP"
                        android:tint="@color/colorPrimaryDark"
                        app:srcCompat="@drawable/ic_cross" />
                </RelativeLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/colorView" />

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:orientation="vertical"
                        android:padding="@dimen/_10DP">


                        <com.google.android.material.textfield.TextInputLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/_50DP"
                            android:textColorHint="@color/dark_gray">

                            <AutoCompleteTextView
                                android:id="@+id/etEmployeeCode"
                                style="@style/TextStyle.Title.Sub"
                                android:layout_width="match_parent"
                                android:layout_height="@dimen/_90DP"
                                android:padding="@dimen/_10DP"
                                android:layout_marginLeft="@dimen/_20DP"
                                android:layout_marginRight="@dimen/_20DP"
                                android:hint="@string/hint_username"
                                android:imeOptions="actionDone"
                                android:maxLength="50"
                                android:maxLines="1"
                                android:paddingBottom="@dimen/_10DP"
                                android:singleLine="true"
                                tools:ignore="RtlHardcoded" />

                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColorHint="@color/dark_gray"
                            app:passwordToggleEnabled="true">

                            <AutoCompleteTextView
                                android:id="@+id/etOtp"
                                style="@style/TextStyle.Title.Sub"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:padding="@dimen/_10DP"
                                android:layout_marginLeft="@dimen/_20DP"
                                android:layout_marginRight="@dimen/_20DP"
                                android:cursorVisible="true"
                                android:hint="@string/hint_otp"
                                android:inputType="number"
                                android:maxLength="6"
                                android:maxLines="1"
                                android:paddingBottom="@dimen/_10DP"
                                android:singleLine="true"
                                android:visibility="gone"
                                tools:ignore="RtlHardcoded" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColorHint="@color/dark_gray"
                            android:visibility="gone"
                            app:passwordToggleEnabled="true">

                            <AutoCompleteTextView
                                android:id="@+id/etPassword"
                                style="@style/TextStyle.Title.Sub"
                                android:layout_width="match_parent"
                                android:layout_height="@dimen/_90DP"
                                android:padding="@dimen/_10DP"
                                android:layout_marginLeft="@dimen/_20DP"
                                android:layout_marginRight="@dimen/_20DP"
                                android:cursorVisible="true"
                                android:hint="@string/hint_password"
                                android:inputType="textPassword"
                                android:maxLines="1"
                                android:paddingBottom="@dimen/_10DP"
                                android:singleLine="true"
                                tools:ignore="RtlHardcoded" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/et_newpass_layout"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColorHint="@color/dark_gray"
                            android:visibility="gone">

                            <EditText
                                android:id="@+id/et_new_password"
                                style="@style/TextStyle.Title.Sub"
                                android:layout_width="match_parent"
                                android:layout_height="@dimen/_90DP"
                                android:padding="@dimen/_10DP"
                                android:layout_marginLeft="@dimen/_20DP"
                                android:layout_marginRight="@dimen/_20DP"
                                android:layout_marginTop="@dimen/_20DP"
                                android:hint="@string/hint_new_password"
                                android:inputType="textPassword"
                                android:maxLength="50"
                                android:maxLines="1"
                                android:paddingBottom="@dimen/_10DP"
                                tools:ignore="RtlHardcoded" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/et_confirm_pass_layout"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColorHint="@color/dark_gray"
                            android:visibility="gone"
                            app:passwordToggleEnabled="true">

                            <EditText
                                android:id="@+id/et_confirm_password"
                                style="@style/TextStyle.Title.Sub"
                                android:layout_width="match_parent"
                                android:layout_height="@dimen/_90DP"
                                android:padding="@dimen/_10DP"
                                android:layout_marginLeft="@dimen/_20DP"
                                android:layout_marginRight="@dimen/_20DP"
                                android:layout_marginTop="@dimen/_20DP"
                                android:cursorVisible="true"
                                android:hint="@string/hint_confirm_password"
                                android:inputType="textPassword"
                                android:maxLength="20"
                                android:maxLines="1"
                                android:paddingBottom="@dimen/_10DP"
                                tools:ignore="RtlHardcoded" />
                        </com.google.android.material.textfield.TextInputLayout>


                        <Button
                            android:id="@+id/btn_forget_password"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_centerHorizontal="true"
                            android:layout_gravity="center"
                            android:layout_marginTop="@dimen/_40DP"
                            android:layout_marginStart="@dimen/_20DP"
                            android:layout_marginEnd="@dimen/_20DP"
                            android:layout_marginBottom="@dimen/_20DP"
                            android:background="@drawable/generic_button"
                            android:gravity="center"
                            android:textSize="15sp"
                            android:elevation="10px"
                            android:textStyle="bold"
                            android:onClick="@{() -> viewModel.onServerLoginClick()}"
                            android:text="@string/submit"
                            android:textColor="@color/white" />

                    </LinearLayout>

                    <androidx.core.widget.ContentLoadingProgressBar
                        style="?android:attr/progressBarStyleLarge"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:baselineAligned="false"
                        android:gravity="center"
                        android:visibility="@{viewModel.isLoading ? View.VISIBLE : View.GONE}" />


                </RelativeLayout>


            </LinearLayout>
        </androidx.cardview.widget.CardView>


