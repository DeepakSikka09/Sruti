<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:context="in.ecomexpress.sathi.ui.dashboard.main.DashboardActivity">

    <data>

        <import type="android.view.View" />

        <variable
            name="viewModel"
            type="in.ecomexpress.sruti.ui.dashboard.sos.SOSViewModel" />
    </data>

    <LinearLayout
        android:id="@+id/popup_element"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#8b8585"
        android:orientation="vertical">



        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical">


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#0e0e0e"
                android:orientation="vertical">

                <in.ecomexpress.sruti.utils.fonts.CustomTextRegular
                    android:id="@+id/textViewEmergencyCall"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerHorizontal="true"
                    android:layout_gravity="center"
                    android:layout_marginTop="@dimen/_50DP"
                    android:gravity="center"
                    android:text="Emergency SOS"
                    android:textColor="@color/white"
                    android:textSize="30sp" />

                <in.ecomexpress.sruti.utils.fonts.CustomTextBold
                    android:id="@+id/txtCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/textViewEmergencyCall"
                    android:layout_centerHorizontal="true"
                    android:layout_gravity="center"
                    android:layout_marginTop="@dimen/_50DP"
                    android:background="@drawable/sos_red_round"
                    android:gravity="center"
                    android:text="1"
                    android:textColor="@color/white"
                    android:textSize="60sp" />


                <!--    <in.ecomexpress.sathi.utils.Fonts.CustomTextBold
                        android:id="@+id/buttonCancel"
                        style="@style/TextStyle.Title.Sub"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginTop="@dimen/_50DP"
                        android:background="@color/transparent"
                        android:drawableTop="@drawable/ic_close"
                        android:gravity="center_horizontal"
                        android:onClick="@{()->viewModel.cancelSOS()}"
                        android:text="Stop"
                        android:textColor="@color/primaryColorDark"
                        android:textSize="15sp" />
-->
                <ProgressBar
                    android:id="@+id/progressBar"
                    style="?android:attr/progressBarStyleLarge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:visibility="gone" />


                <RelativeLayout
                    android:id="@+id/lltFooter"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_gravity="bottom"
                    android:layout_margin="@dimen/_10DP"
                    android:layout_weight=".02"
                    android:gravity="center">


                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_gravity="bottom"
                        android:layout_margin="@dimen/_10DP"
                        android:gravity="bottom"
                        android:orientation="vertical">

                        <ImageView
                            android:id="@+id/buttonCancel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:gravity="center"
                            android:onClick="@{()->viewModel.cancelSOS()}"
                            android:padding="@dimen/_30DP"
                            android:text="@string/stop"
                            android:textColor="@color/colorAccent1"
                            android:textSize="15sp"
                            android:tint="@color/colorAccent1"
                            android:layout_marginBottom="@dimen/_30DP"
                            android:textStyle="bold"
                            app:srcCompat="@drawable/cross" />

                      <!--  <in.ecomexpress.sathi.utils.Fonts.CustomTextRegular
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_below="@+id/textViewEmergencyCall"
                            android:layout_centerHorizontal="true"
                            android:layout_gravity="center"
                            android:layout_marginBottom="@dimen/_30DP"
                            android:gravity="center"
                            android:text="Stop"
                            android:textColor="@color/white"
                            android:textSize="25sp" />-->

                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/bottomLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_alignParentBottom="true"
                        android:layout_margin="@dimen/_10DP"
                        android:orientation="vertical"
                        android:visibility="gone"
                        android:weightSum=".1">

                        <Button
                            android:id="@+id/stopCalling"
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_weight=".05"
                            android:background="@drawable/white_round"
                            android:gravity="center"
                            android:text="Stop Calling"
                            android:textColor="@color/colorAccent1"
                            android:textSize="20sp"
                            android:textStyle="bold" />

                        <Button
                            android:id="@+id/cancel"
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_marginTop="@dimen/_20DP"
                            android:layout_weight=".05"
                            android:background="@drawable/white_round"
                            android:gravity="center"
                            android:text="Cancel"
                            android:textColor="@color/blue_grey_light"
                            android:textSize="20sp"
                            android:textStyle="bold" />

                    </LinearLayout>
                </RelativeLayout>
            </LinearLayout>
        </LinearLayout>
        <!--</android.support.v7.widget.CardView>-->
    </LinearLayout>
</layout>