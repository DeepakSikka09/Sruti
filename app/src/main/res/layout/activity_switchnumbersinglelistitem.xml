<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>

        <variable
            name="viewModel"
            type="in.ecomexpress.sruti.ui.dashboard.switchnumber.SwitchNumberItemViewModel" />

    </data>

    <LinearLayout
        android:id="@+id/popup_element"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/colorBackground"
        android:layout_margin="@dimen/_10DP"
        android:padding="@dimen/_5DP"
        android:elevation="10px"
        android:orientation="horizontal">


        <!--   <android.support.v7.widget.CardView
               android:layout_width="@dimen/_10DP"
               android:layout_height="match_parent"
               android:layout_marginBottom="@dimen/_5DP"
               android:layout_marginLeft="@dimen/_5DP"
               android:layout_marginStart="@dimen/_5DP"
               android:layout_marginTop="@dimen/_5DP"
               android:background="?android:attr/selectableItemBackground"
               android:focusable="true"
               app:cardBackgroundColor="@color/colorPrimaryDark"
               app:cardCornerRadius="@dimen/_7DP"
               app:cardElevation="@dimen/_20DP"></android.support.v7.widget.CardView>
   -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/_5DP"
            android:padding="@dimen/_5DP"
            android:background="@color/colorAccent2"
            android:onClick="@{() -> viewModel.onItemClick()}"

          >

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
               android:background="@color/colorAccent2"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/colorAccent2"
                    android:orientation="horizontal">

                    <in.ecomexpress.sruti.utils.fonts.CustomTextRegular
                        android:id="@+id/format"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:layout_gravity="center"
                        android:layout_weight="0.1"
                        android:gravity="start"
                        android:hint="format"
                        android:text="@{ viewModel.PstnFormat}"
                        android:textColor="@color/black"
                        android:textSize="13sp" />

                    <in.ecomexpress.sruti.utils.fonts.CustomTextRegular
                        android:id="@+id/provider"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:layout_gravity="center"
                        android:layout_weight="0.1"
                        android:gravity="end"
                        android:hint="format"
                        android:text="@{ viewModel.PstnProvider}"
                        android:textColor="@color/red_ecom"
                        android:textSize="13sp" />


                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:visibility="gone"
                    android:layout_height="wrap_content"
                    android:background="@color/colorBackground"
                    android:orientation="horizontal">

                    <in.ecomexpress.sruti.utils.fonts.CustomTextBold
                        android:id="@+id/islocal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:layout_gravity="center"
                        android:layout_weight="0.1"
                        android:gravity="start"
                        android:hint="isLocal"
                        android:text="@{ viewModel.IsLocal()}"
                        android:textColor="@color/gray"
                        android:textSize="13sp" />

                    <in.ecomexpress.sruti.utils.fonts.CustomTextBold
                        android:id="@+id/additional"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:layout_gravity="center"
                        android:layout_weight="0.1"
                        android:gravity="end"
                        android:hint="Additional"
                        android:text="@{ viewModel.Additional()}"
                        android:textColor="@color/gray"
                        android:textSize="13sp" />


                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</layout>