<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="15dp"
    android:background="@drawable/curved_rectangle_with_grey_border"
    android:orientation="vertical">


    <LinearLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:orientation="horizontal">

        <androidx.appcompat.widget.AppCompatButton
            android:layout_margin="@dimen/_10DP"
            android:padding="@dimen/_10DP"
            android:drawableEnd="@drawable/ic_call_new"
            android:layout_weight=".5"
            android:id="@+id/primary_call_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/call1"
            android:layout_marginTop="@dimen/_20DP"
            android:textColor="@color/white"
            android:background="@drawable/generic_button"
            android:textSize="15sp"
            android:textStyle="bold"
            />
        <androidx.appcompat.widget.AppCompatButton
            android:layout_margin="@dimen/_10DP"
            android:padding="@dimen/_10DP"
            android:drawableEnd="@drawable/ic_call_new"
            android:id="@+id/secondary_call_button"
            android:layout_weight=".5"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/call_2"
            android:textColor="@color/white"
            android:layout_marginTop="@dimen/_20DP"
            android:background="@drawable/generic_button"
            android:textSize="15sp"
            android:textStyle="bold"
            />



    </LinearLayout>


</LinearLayout>