<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:context=".ui.dashboard.signature.SignatureActivity">

    <data>

        <import type="android.view.View" />

        <variable
            name="viewModel"
            type="in.ecomexpress.sruti.ui.dashboard.signature.SignatureViewModel" />
    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@color/colorBackground"
            android:elevation="10px"
            android:orientation="horizontal"
            android:weightSum=".09">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight=".01">

                <ImageView
                    android:id="@+id/imageViewBack"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_gravity="center"
                    android:background="@null"
                    android:padding="@dimen/_10DP"
                    app:srcCompat="@drawable/back" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight=".07"
                android:orientation="horizontal">

                <in.ecomexpress.sruti.utils.fonts.CustomTextBold
                    style="@style/TextStyle.Title.Sub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="start"
                    android:padding="@dimen/_15DP"
                    android:text="@string/signature"
                    android:textColor="@color/colorPrimaryDark"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <in.ecomexpress.sruti.utils.fonts.CustomTextBold
                android:id="@+id/imageViewNext"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:layout_weight=".01"
                android:gravity="center"
                android:text="@string/v2_0_0"
                android:textColor="@color/colorAccent1"
                android:textSize="12sp" />
        </LinearLayout>

        <View
            android:id="@+id/view"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_below="@+id/toolbar"
            android:layout_gravity="center"
            android:background="@color/colorView"
            android:gravity="center" />

        <LinearLayout
            android:id="@+id/linear_menu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/_10DP"
            android:orientation="horizontal">
            <!--CHILD ONE-->
            <LinearLayout
                android:id="@+id/layout_child1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_margin="@dimen/_15DP"
                android:background="@drawable/border"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="@dimen/_15DP"
                android:paddingBottom="@dimen/_1DP">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/_2DP">

                    <in.ecomexpress.sruti.utils.fonts.CustomTextBold
                        android:id="@+id/consignee_name"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_gravity="start"
                        android:layout_marginBottom="@dimen/_2DP"
                        android:layout_weight=".08"
                        android:gravity="start"
                        android:maxLines="2"
                        android:padding="@dimen/_1DP"
                        android:scrollbars="vertical"
                        android:text="@string/total_manifest"
                        android:textColor="@color/colorText"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <in.ecomexpress.sruti.utils.fonts.CustomTextBold
                        android:id="@+id/txt_manifest"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_gravity="end"
                        android:layout_marginBottom="@dimen/_2DP"
                        android:layout_weight=".02"
                        android:gravity="end"
                        android:padding="@dimen/_1DP"
                        android:text="1"
                        android:textColor="@color/colorText"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/_2DP"
                    android:orientation="horizontal">

                    <in.ecomexpress.sruti.utils.fonts.CustomTextBold
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_gravity="start"
                        android:layout_marginBottom="@dimen/_2DP"
                        android:layout_weight=".08"
                        android:gravity="start"
                        android:maxLines="2"
                        android:padding="@dimen/_1DP"
                        android:scrollbars="vertical"
                        android:text="@string/total_shipment"
                        android:textColor="@color/colorText"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <in.ecomexpress.sruti.utils.fonts.CustomTextBold
                        android:id="@+id/txt_shipment"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_gravity="end"
                        android:layout_marginBottom="@dimen/_2DP"
                        android:layout_weight=".02"
                        android:gravity="end"
                        android:padding="@dimen/_1DP"
                        android:textColor="@color/colorText"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/_2DP"
                    android:orientation="horizontal">

                    <in.ecomexpress.sruti.utils.fonts.CustomTextBold
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_gravity="start"
                        android:layout_marginBottom="@dimen/_2DP"
                        android:layout_weight=".08"
                        android:gravity="start"
                        android:maxLines="2"
                        android:padding="@dimen/_1DP"
                        android:scrollbars="vertical"
                        android:text="@string/picked_shipment"
                        android:textColor="@color/colorText"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <in.ecomexpress.sruti.utils.fonts.CustomTextBold
                        android:id="@+id/txt_picked"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_gravity="end"
                        android:layout_marginBottom="@dimen/_2DP"
                        android:layout_weight=".02"
                        android:gravity="end"
                        android:padding="@dimen/_1DP"
                        android:textColor="@color/colorText"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/_2DP"
                    android:orientation="horizontal">

                    <in.ecomexpress.sruti.utils.fonts.CustomTextBold
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_gravity="start"
                        android:layout_marginBottom="@dimen/_2DP"
                        android:layout_weight=".08"
                        android:gravity="start"
                        android:maxLines="2"
                        android:padding="@dimen/_1DP"
                        android:scrollbars="vertical"
                        android:text="@string/unpicked_shipment"
                        android:textColor="@color/colorText"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <in.ecomexpress.sruti.utils.fonts.CustomTextBold
                        android:id="@+id/txt_unpicked"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_gravity="end"
                        android:layout_marginBottom="@dimen/_2DP"
                        android:layout_weight=".02"
                        android:gravity="end"
                        android:padding="@dimen/_1DP"
                        android:textColor="@color/colorText"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/_2DP"
                    android:orientation="horizontal">

                    <in.ecomexpress.sruti.utils.fonts.CustomTextBold
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_gravity="start"
                        android:layout_marginBottom="@dimen/_2DP"
                        android:layout_weight=".08"
                        android:gravity="start"
                        android:maxLines="2"
                        android:padding="@dimen/_1DP"
                        android:scrollbars="vertical"
                        android:text="@string/remaining_shipment"
                        android:textColor="@color/colorText"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <in.ecomexpress.sruti.utils.fonts.CustomTextBold
                        android:id="@+id/txt_remaining"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_gravity="end"
                        android:layout_marginBottom="@dimen/_2DP"
                        android:layout_weight=".02"
                        android:gravity="end"
                        android:padding="@dimen/_1DP"
                        android:textColor="@color/colorText"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/is_advance"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/_2DP"
                    android:orientation="horizontal">

                    <in.ecomexpress.sruti.utils.fonts.CustomTextBold
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_gravity="start"
                        android:layout_marginBottom="@dimen/_2DP"
                        android:layout_weight=".08"
                        android:gravity="start"
                        android:maxLines="2"
                        android:padding="@dimen/_1DP"
                        android:scrollbars="vertical"
                        android:text="@string/advance_shipment"
                        android:textColor="@color/colorText"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <in.ecomexpress.sruti.utils.fonts.CustomTextBold
                        android:id="@+id/txt_advance_shipment"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_gravity="end"
                        android:layout_marginBottom="@dimen/_2DP"
                        android:layout_weight=".02"
                        android:gravity="end"
                        android:padding="@dimen/_1DP"
                        android:textColor="@color/colorText"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <RelativeLayout
            android:id="@+id/rl_proof_of_pickup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/_10DP"
            android:padding="@dimen/_5DP">

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tv_proof_info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_15DP"
                android:text="@string/choose_mobile_no"
                android:textColor="@color/black"
                android:textSize="@dimen/_15sp"
                android:textStyle="bold" />

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_below="@+id/tv_proof_info"
                android:background="@drawable/curved_rectangle_with_grey_border">

                <androidx.appcompat.widget.AppCompatSpinner
                    android:id="@+id/spinner"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="right"
                    android:text="@string/ok"
                    android:visibility="visible" />
            </RelativeLayout>
            <!--<com.google.android.material.textfield.TextInputLayout
                 android:layout_width="match_parent"
                android:layout_height="@dimen/_100DP"
                android:layout_below="@id/tv_proof_info"
                android:layout_margin="@dimen/_10DP"
                android:background="@drawable/curved_rectangle_with_grey_border">
                &lt;!&ndash; Inside text input layout add
                      an auto complete text view
                        and make its input type to none&ndash;&gt;
                <AutoCompleteTextView
                    android:id="@+id/autoCompleteTextView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_margin="@dimen/_10DP"
                    android:layout_weight="1"
                    android:background="@color/white"
                    android:inputType="none"
                    android:text="@string/select_mobile_number" />
            </com.google.android.material.textfield.TextInputLayout>
  -->
        </RelativeLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_10DP"
            android:layout_marginEnd="@dimen/_10DP"
            android:background="@color/colorBackground"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/linear_image"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginStart="@dimen/_15DP"
                android:layout_marginEnd="@dimen/_15DP"
                android:orientation="horizontal"
                android:padding="@dimen/_10DP"
                android:weightSum=".10">

                <in.ecomexpress.sruti.utils.fonts.CustomTextRegular
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_weight=".08"
                    android:gravity="center|start"
                    android:padding="@dimen/_5DP"
                    android:text="@string/camera"
                    android:textColor="@color/black"
                    android:textSize="13sp" />

                <ImageView
                    android:id="@+id/image_capture"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:layout_weight=".02"
                    android:gravity="end"
                    android:padding="@dimen/_5DP"
                    app:srcCompat="@drawable/cam" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/signature_txt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_15DP"
                android:layout_marginEnd="@dimen/_15DP"
                android:orientation="horizontal"
                android:padding="@dimen/_10DP"
                android:weightSum=".10">

                <in.ecomexpress.sruti.utils.fonts.CustomTextRegular
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_weight=".08"
                    android:gravity="center|start"
                    android:padding="@dimen/_5DP"
                    android:text="@string/signature"
                    android:textColor="@color/black"
                    android:textSize="@dimen/_13sp" />

                <in.ecomexpress.sruti.utils.fonts.CustomTextRegular
                    android:id="@+id/txt_onClear"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:layout_weight=".02"
                    android:gravity="end"
                    android:padding="@dimen/_5DP"
                    android:text="@string/clear"
                    android:textColor="@color/colorAccent1"
                    android:textSize="@dimen/_13sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/signature_pad"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginLeft="@dimen/_25DP"
            android:layout_marginRight="@dimen/_25DP"
            android:layout_weight="0.8"
            android:background="@drawable/border"
            android:gravity="center">

            <in.ecomexpress.sruti.utils.common_files.signature_pad.views.SignaturePad
                android:id="@+id/signature"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_margin="@dimen/_5DP"
                android:background="@null"
                android:gravity="center"
                android:minHeight="@dimen/_300DP" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_margin="@dimen/_20DP"
            android:layout_weight=".01"
            android:gravity="bottom"
            android:orientation="horizontal"
            android:padding="@dimen/_10DP">

            <Button
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:background="@drawable/generic_button"
                android:elevation="10px"
                android:gravity="center"
                android:onClick="@{() -> viewModel.onSubmitClick()}"
                android:text="@string/submit_"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</layout>