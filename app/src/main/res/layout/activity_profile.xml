                        android:gravity="start"

                        android:orientation="horizontal"
                        android:paddingEnd="@dimen/_20DP"
                        android:paddingStart="@dimen/_20DP">

                        <in.ecomexpress.sruti.utils.fonts.CustomTextBold
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:text="Code"
                            android:gravity="center"
                            android:textColor="@color/black"
                            android:textSize="15sp" />

                        <in.ecomexpress.sruti.utils.fonts.CustomTextRegular
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:gravity="end|center"
                            android:hint="@string/app_name"
                            android:text="@{viewModel.code}"
                            android:textColor="@color/colorText"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_margin="@dimen/_20DP"
                        android:layout_weight=".03"
                        android:background="@drawable/delivered_gradient"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="start"

                        android:orientation="horizontal"
                        android:paddingEnd="@dimen/_20DP"
                        android:paddingStart="@dimen/_20DP">

                        <in.ecomexpress.sruti.utils.fonts.CustomTextBold
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:text="Mobile"
                            android:gravity="center"
                            android:textColor="@color/black"
                            android:textSize="15sp" />

                        <in.ecomexpress.sruti.utils.fonts.CustomTextRegular
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:gravity="end|center"
                            android:hint="@string/app_name"
                            android:text="@{viewModel.empMobile}"
                            android:textColor="@color/colorText"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_margin="@dimen/_20DP"
                        android:layout_weight=".03"
                        android:background="@drawable/delivered_gradient"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="start"
                        android:orientation="horizontal"
                        android:paddingEnd="@dimen/_20DP"
                        android:paddingStart="@dimen/_20DP">

                        <in.ecomexpress.sruti.utils.fonts.CustomTextBold
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:text="Location"
                            android:gravity="center"
                            android:textColor="@color/black"
                            android:textSize="15sp" />

                        <in.ecomexpress.sruti.utils.fonts.CustomTextRegular
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:gravity="end|center"
                            android:hint="@string/app_name"
                            android:text="@{viewModel.empServicecenter}"
                            android:textColor="@color/colorText"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                    </LinearLayout>


                </LinearLayout>
</ScrollView>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </RelativeLayout>
    </LinearLayout>

