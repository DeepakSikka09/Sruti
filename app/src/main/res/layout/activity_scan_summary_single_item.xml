<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>

        <variable
            name="viewModel"
            type="in.ecomexpress.sruti.ui.dashboard.globalscansummary.GlobalManifestSummaryAdapterViewModel" />

    </data>

  <!--  <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/_5DP"
        android:orientation="vertical">-->

    <androidx.cardview.widget.CardView android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/_10DP"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="@dimen/_7DP"
        app:cardElevation="@dimen/_10DP"
      >

        <LinearLayout
            android:id="@+id/linear_parent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/_5DP"
            android:background="@color/white"
            android:orientation="horizontal"
            android:padding="@dimen/_5DP">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight=".85"
                    android:background="@color/white"
                    android:orientation="vertical">

                    <in.ecomexpress.sruti.utils.fonts.CustomTextBold
                        android:id="@+id/awb_no"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@{ viewModel.shipperName}"
                        android:textColor="@color/colorPrimaryDark"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <in.ecomexpress.sruti.utils.fonts.CustomTextRegular
                        android:id="@+id/parent_awb_no"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@{ viewModel.manifestID}"
                        android:textColor="@color/colorAccent1"
                        android:textSize="12sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <in.ecomexpress.sruti.utils.fonts.CustomTextRegular
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_gravity="start"
                            android:layout_marginBottom="@dimen/_2DP"
                            android:layout_weight=".08"
                            android:gravity="start"
                            android:maxLines="2"
                            android:padding="@dimen/_1DP"
                            android:scrollbars="vertical"
                            android:text="Total"
                            android:textColor="@color/colorText"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <in.ecomexpress.sruti.utils.fonts.CustomTextRegular
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_gravity="end"
                            android:layout_marginBottom="@dimen/_2DP"
                            android:layout_weight=".02"
                            android:gravity="start"
                            android:padding="@dimen/_1DP"
                            android:text="@{ viewModel.totalItem}"
                            android:textColor="@color/colorText"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <in.ecomexpress.sruti.utils.fonts.CustomTextRegular
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_gravity="start"
                            android:layout_marginBottom="@dimen/_2DP"
                            android:layout_weight=".08"
                            android:gravity="start"
                            android:maxLines="2"
                            android:padding="@dimen/_1DP"
                            android:scrollbars="vertical"
                            android:text="Picked"
                            android:textColor="@color/colorText"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <in.ecomexpress.sruti.utils.fonts.CustomTextRegular
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_gravity="end"
                            android:layout_marginBottom="@dimen/_2DP"
                            android:layout_weight=".02"
                            android:gravity="start"
                            android:padding="@dimen/_1DP"
                            android:text="@{ viewModel.totalpicked}"
                            android:textColor="@color/colorText"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <in.ecomexpress.sruti.utils.fonts.CustomTextRegular
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_gravity="start"
                            android:layout_marginBottom="@dimen/_2DP"
                            android:layout_weight=".08"
                            android:gravity="start"
                            android:maxLines="2"
                            android:padding="@dimen/_1DP"
                            android:scrollbars="vertical"
                            android:text="Unpicked"
                            android:textColor="@color/colorText"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <in.ecomexpress.sruti.utils.fonts.CustomTextRegular
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_gravity="end"
                            android:layout_marginBottom="@dimen/_2DP"
                            android:layout_weight=".02"
                            android:gravity="start"
                            android:padding="@dimen/_1DP"
                            android:text="@{ viewModel.totalunpicked}"
                            android:textColor="@color/colorText"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <in.ecomexpress.sruti.utils.fonts.CustomTextRegular
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_gravity="start"
                            android:layout_marginBottom="@dimen/_2DP"
                            android:layout_weight=".08"
                            android:gravity="start"
                            android:maxLines="2"
                            android:padding="@dimen/_1DP"
                            android:scrollbars="vertical"
                            android:text="Remaining"
                            android:textColor="@color/colorText"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <in.ecomexpress.sruti.utils.fonts.CustomTextRegular
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_gravity="end"
                            android:layout_marginBottom="@dimen/_2DP"
                            android:layout_weight=".02"
                            android:gravity="start"
                            android:padding="@dimen/_1DP"
                            android:text="@{ viewModel.totalcancelled}"
                            android:textColor="@color/colorText"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                </LinearLayout>

                <ImageView

                    android:id="@+id/cam"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_gravity="center|end"
                    android:layout_weight=".15"
                    android:onClick="@{() -> viewModel.onCameraClick()}"
                    android:background="@color/white"
                    android:gravity="center"
                    android:padding="@dimen/_25DP"
                    app:srcCompat="@drawable/cam" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

   <!-- </LinearLayout>-->

</layout>