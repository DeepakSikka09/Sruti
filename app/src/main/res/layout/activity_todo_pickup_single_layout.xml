<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="viewModel"
            type="in.ecomexpress.sruti.ui.dashboard.todolist.todo_item_viewmodel.PickupItemViewModel" />

    </data>

    <LinearLayout
        android:id="@+id/popup_element"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/colorBackground"
        android:orientation="horizontal">


        <androidx.cardview.widget.CardView
            android:layout_width="@dimen/_10DP"
            android:layout_height="match_parent"
            android:layout_marginBottom="@dimen/_5DP"
            android:layout_marginLeft="@dimen/_5DP"
            android:layout_marginStart="@dimen/_5DP"
            android:layout_marginTop="@dimen/_5DP"
            android:focusable="true"
            app:cardBackgroundColor="@color/pickup"
            app:cardCornerRadius="@dimen/_7DP"
            app:cardElevation="@dimen/_20DP"></androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:id="@+id/colors"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/_5DP"
            android:onClick="@{() -> viewModel.onItemClick()}"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="@dimen/_7DP"
            app:cardElevation="@dimen/_20DP">

            <LinearLayout
                android:id="@+id/layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/white"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/color"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/_3DP"
                    android:background="@color/white"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@null"
                        android:orientation="horizontal"
                        android:paddingLeft="@dimen/_5DP"
                        android:paddingStart="@dimen/_5DP"
                        android:weightSum=".10">
                        <!--Name,AWB,pin-->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight=".06"
                            android:background="@null"
                            android:orientation="vertical">

                            <in.ecomexpress.sruti.utils.fonts.CustomTextBold
                                android:id="@+id/consignee_name"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="start"
                                android:gravity="start"
                                android:hint="Suraj Sud"
                                android:padding="@dimen/_1DP"
                                android:textColor="@color/red_ecom"
                                android:textColorHint="@color/red_ecom"
                                android:textSize="13sp" />


                            <in.ecomexpress.sruti.utils.fonts.CustomTextBold
                                android:layout_width="wrap_content"

                                android:layout_height="wrap_content"
                                android:layout_gravity="start"
                                android:layout_marginEnd="@dimen/_2DP"
                                android:layout_marginRight="@dimen/_2DP"
                                android:gravity="start"
                                android:hint="Amazon"
                                android:textColor="@color/colorText"
                                android:textColorHint="@color/colorText"
                                android:textSize="11sp" />

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="start"
                                android:background="@null"
                                android:gravity="start"
                                android:orientation="horizontal">

                                <in.ecomexpress.sruti.utils.fonts.CustomTextBold
                                    android:id="@+id/awb"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="start"
                                    android:layout_marginEnd="@dimen/_2DP"
                                    android:layout_marginRight="@dimen/_2DP"
                                    android:gravity="start"
                                    android:hint="43789990"
                                    android:textColor="@color/colorText"
                                    android:textColorHint="@color/colorText"
                                    android:textSize="11sp" />
                                <!--    </LinearLayout>-->

                                <View
                                    android:id="@+id/viewDivider"
                                    android:layout_width="1dp"
                                    android:layout_height="match_parent"
                                    android:layout_gravity="center"
                                    android:layout_margin="@dimen/_5DP"
                                    android:background="@color/colorPrimary"
                                    android:gravity="center" />

                                <in.ecomexpress.sruti.utils.fonts.CustomTextBold
                                    android:id="@+id/pin"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="start"
                                    android:layout_marginLeft="2dp"
                                    android:layout_marginRight="@dimen/_2DP"
                                    android:gravity="start"
                                    android:hint="1234"
                                    android:textColor="@color/colorText"
                                    android:textColorHint="@color/colorText"
                                    android:textSize="11sp" />

                                <!--    <View
                                        android:layout_width="1dp"
                                        android:layout_height="match_parent"
                                        android:layout_gravity="center"
                                        android:layout_margin="@dimen/_5DP"
                                        android:background="@color/colorPrimary"
                                        android:gravity="center" />
    -->

                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@null"
                                android:orientation="vertical">

                                <in.ecomexpress.sruti.utils.fonts.CustomTextBold
                                    android:id="@+id/amount"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="start"
                                    android:gravity="start"
                                    android:hint="Rs. 50000.0"
                                    android:textColor="@color/colorText"
                                    android:textColorHint="@color/colorText"
                                    android:textSize="11sp" />

                                <in.ecomexpress.sruti.utils.fonts.CustomTextBold
                                    android:id="@+id/addressline1"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="start"
                                    android:gravity="start"
                                    android:hint="line1"
                                    android:textColor="@color/colorText"
                                    android:textColorHint="@color/colorText"
                                    android:textSize="11sp" />
                            </LinearLayout>

                            <LinearLayout
                                android:id="@+id/fullview"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:background="@color/white"
                                android:gravity="center"
                                android:orientation="vertical"
                                android:visibility="gone">

                                <!--  <LinearLayout
                                      android:layout_width="match_parent"
                                      android:layout_height="wrap_content"
                                      android:layout_gravity="center"
                                      android:background="@color/white"
                                      android:gravity="center"
                                      android:orientation="vertical">-->


                                <in.ecomexpress.sruti.utils.fonts.CustomTextBold
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="start"
                                    android:gravity="start"
                                    android:hint="address"
                                    android:textColor="@color/colorText"
                                    android:textSize="11sp" />


                                <!--  </LinearLayout>-->
                            </LinearLayout>

                        </LinearLayout>

                        <!--call n navigation icon-->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_gravity="end"
                            android:layout_weight=".04"
                            android:background="@null"
                            android:gravity="end"
                            android:orientation="horizontal"
                            android:weightSum=".10">


                            <ImageView
                                android:id="@+id/call"
                                android:layout_width="35dp"
                                android:layout_height="35dp"
                                android:layout_gravity="center_vertical"
                                android:layout_marginEnd="@dimen/_10DP"
                                android:layout_marginRight="@dimen/_10DP"
                                android:layout_marginStart="@dimen/_10DP"
                                android:background="@drawable/circular_red"
                                android:gravity="end"
                                android:onClick="@{() -> viewModel.onCallClick()}"
                                android:padding="@dimen/_3DP"
                                android:scaleType="centerCrop"
                                app:srcCompat="@drawable/ic_action_callbridge"
                                tools:ignore="VectorDrawableCompat" />

                            <!-- android:onClick="@{() -> viewModel.onCallClick()}"-->

                            <LinearLayout
                                android:id="@+id/navView"
                                android:layout_width="35dp"
                                android:layout_height="35dp"
                                android:layout_gravity="center_vertical"
                                android:layout_marginEnd="@dimen/_10DP"
                                android:layout_marginLeft="@dimen/_10DP"
                                android:layout_marginRight="@dimen/_10DP"
                                android:background="@drawable/circular_red"
                                android:gravity="end"
                                android:orientation="horizontal"
                                android:weightSum=".10">

                                <ImageView
                                    android:id="@+id/map"
                                    android:layout_width="35dp"
                                    android:layout_height="35dp"
                                    android:layout_gravity="center_vertical"
                                    android:gravity="end"
                                    android:src="@drawable/ic_action_trip"
                                    android:onClick="@{() -> viewModel.onMapClick()}"
                                    android:padding="@dimen/_1DP"
                                    android:scaleType="centerCrop"
                                    tools:ignore="VectorDrawableCompat" />
                            </LinearLayout>
                        </LinearLayout>

                        <!--   android:background="@drawacircular_blueward"
                        app:srcCompat="@drawable/ic_action_trip"-->

                    </LinearLayout>


                    <LinearLayout
                        android:id="@+id/tray"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:background="@color/colorIconTray"
                        android:gravity="start"
                        android:onClick="@{() -> viewModel.onTrayClick()}"
                        android:orientation="horizontal"
                        android:padding="@dimen/_5DP"
                        android:weightSum=".10">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:layout_weight=".08"
                            android:background="@color/colorIconTray"
                            android:gravity="start"
                            android:onClick="@{() -> viewModel.onTrayClick()}"
                            android:orientation="horizontal"
                            android:padding="@dimen/_5DP">


                            <ImageView
                                android:id="@+id/imageViewSynced"
                                android:layout_width="15dp"
                                android:layout_height="15dp"
                                android:layout_gravity="center"
                                android:scaleType="centerCrop"
                                android:visibility="visible" />

                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/indicator"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_gravity="center"
                            android:layout_weight=".02"
                            android:gravity="end"
                            android:onClick="@{() -> viewModel.onIndicatorClick()}"
                            android:orientation="horizontal"
                            android:weightSum=".10">

                            <in.ecomexpress.sruti.utils.fonts.CustomButtonRegular
                                android:id="@+id/moreorless"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_gravity="center"
                                android:layout_marginEnd="@dimen/_5DP"
                                android:layout_marginRight="@dimen/_5DP"
                                android:layout_weight=".08"
                                android:background="@null"
                                android:gravity="center|end"
                                android:onClick="@{() -> viewModel.onIndicatorClick()}"
                                android:text="more"
                                android:textColor="@color/colorText"
                                android:textSize="10sp" />

                            <ImageView
                                android:layout_width="12dp"
                                android:layout_height="match_parent"
                                android:layout_gravity="end"
                                android:layout_marginLeft="@dimen/_5DP"
                                android:layout_marginStart="@dimen/_5DP"
                                android:layout_weight=".02"
                                android:background="@null"
                                android:gravity="center"
                                android:onClick="@{() -> viewModel.onIndicatorClick()}"
                                android:src="@drawable/ic_arrowup"
                                android:tint="@color/pickuptool"
                                android:visibility="visible"
                                tools:ignore="VectorDrawableCompat" />

                            <!--                            android:src="@{viewModel.indicator ? @drawable/arrowdown : @drawable/ic_arrowup}"
    -->
                        </LinearLayout>
                    </LinearLayout>


                </LinearLayout>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</layout>