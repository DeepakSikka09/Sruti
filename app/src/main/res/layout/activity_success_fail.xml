<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:context=".ui.dashboard.signature.SuccessFailActivity">

    <data>

        <import type="android.view.View" />

        <variable
            name="viewModel"
            type="in.ecomexpress.sruti.ui.dashboard.signature.SuccessFailViewModel" />

    </data>

    <RelativeLayout
        android:id="@+id/relative_head"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/white"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@color/colorBackground"
            android:elevation="10px"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight=".01">

                <ImageView
                    android:id="@+id/imageViewBack"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_gravity="center"
                    android:layout_weight=".0"
                    android:background="@null"
                    android:padding="@dimen/_10DP"
                    app:srcCompat="@drawable/back" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight=".07"
                android:orientation="horizontal">


                <in.ecomexpress.sruti.utils.fonts.CustomTextBold
                    style="@style/TextStyle.Title.Sub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="start"
                    android:padding="@dimen/_15DP"
                    android:text="@string/shipment_status_value"
                    android:textColor="@color/colorPrimaryDark"
                    android:textSize="15sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <in.ecomexpress.sruti.utils.fonts.CustomTextBold
                android:id="@+id/imageViewNext"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_weight=".01"
                android:gravity="center"
                android:text="@string/v2_0_0"
                android:textColor="@color/colorAccent1"
                android:textSize="12sp" />

        </LinearLayout>

        <View
            android:id="@+id/view"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_below="@+id/toolbar"
            android:layout_gravity="center"
            android:background="@color/colorView"
            android:gravity="center" />

        <ImageView
            android:id="@+id/img_cross"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="@dimen/_100DP"
            android:background="@drawable/cross"
            android:tint="@color/red"
            android:visibility="gone" />


        <ImageView
            android:id="@+id/img_tick"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="@dimen/_100DP"
            android:background="@drawable/tick"
            android:tint="@color/green"
            android:visibility="visible" />

        <in.ecomexpress.sruti.utils.fonts.CustomTextRegular
            android:id="@+id/decideText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/img_tick"
            android:layout_centerHorizontal="true"
            android:gravity="center"
            android:text="@string/Success"
            android:textColor="@color/green"
            android:textSize="@dimen/_25sp"
            android:textStyle="bold"
            android:visibility="visible" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/manifest_user_detail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_above="@+id/btn_home"
            android:layout_below="@+id/decideText"
            android:layout_marginTop="@dimen/_20DP" />


        <Button
            android:id="@+id/btn_home"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_gravity="center"
            android:layout_margin="@dimen/_20DP"
            android:background="@drawable/generic_button"
            android:elevation="10px"
            android:gravity="center"
            android:padding="@dimen/_10DP"
            android:text="@string/home"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:textStyle="bold" />
    </RelativeLayout>


</layout>