<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:context=".ui.dashboard.fuel.FuelReimburseActivity">

    <data>

        <variable
            name="viewModel"
            type="in.ecomexpress.sruti.ui.dashboard.fuel.FuelReimburseViewModel" />
    </data>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/colorBackground"
        android:orientation="vertical">


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/colorBackground"
            android:orientation="vertical">


            <LinearLayout
                android:elevation="10px"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/colorBackground"
                android:orientation="horizontal"
                android:weightSum=".1">

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:background="@null"
                    android:onClick="@{() -> viewModel.onBackClick()}"
                    android:padding="@dimen/_10DP"
                    app:srcCompat="@drawable/back"
                    android:tint="@color/colorPrimaryDark" />

                <in.ecomexpress.sruti.utils.fonts.CustomTextBold
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="@dimen/_15DP"
                    android:text="@string/fuel_reimbursement"
                    android:textColor="@color/colorPrimaryDark"
                    android:textSize="15sp" />

                <in.ecomexpress.sruti.utils.fonts.CustomTextBold
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="end"
                    android:layout_marginEnd="@dimen/_10DP"
                    android:layout_marginRight="@dimen/_10DP"
                    android:gravity="center|end"
                    android:text="@string/v2_0_0"
                    android:textColor="@color/colorAccent1"
                    android:textSize="13sp" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/colorView" />

            <LinearLayout
                android:id="@+id/icons"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:background="@color/colorBackground"
                android:gravity="center"
                android:orientation="horizontal"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:padding="@dimen/_2DP">

                    <ImageView
                        android:layout_width="@dimen/_20DP"
                        android:layout_height="@dimen/_20DP"
                        android:layout_gravity="center"
                        android:layout_margin="@dimen/_5DP"
                        android:gravity="center"
                        android:src="@drawable/deliver"
                        android:tint="@color/colorPrimaryDark" />

                    <in.ecomexpress.sruti.utils.fonts.CustomTextRegular

                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:gravity="center"
                        android:text="Delivered"
                        android:textColor="@color/black"
                        android:textSize="12sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/_30DP"
                    android:layout_marginStart="@dimen/_30DP"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:padding="@dimen/_2DP">

                    <ImageView
                        android:layout_width="@dimen/_20DP"
                        android:layout_height="@dimen/_20DP"
                        android:layout_gravity="center"
                        android:layout_margin="@dimen/_5DP"
                        android:gravity="center"
                        android:src="@drawable/undeliver"
                        android:tint="@color/red_ecom" />

                    <in.ecomexpress.sruti.utils.fonts.CustomTextRegular

                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:gravity="center"
                        android:text="Undelivered"
                        android:textColor="@color/black"
                        android:textSize="12sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:padding="@dimen/_2DP"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="@dimen/_20DP"
                        android:layout_height="@dimen/_20DP"
                        android:layout_gravity="center"
                        android:layout_margin="@dimen/_5DP"
                        android:gravity="center"
                        android:src="@drawable/undeliver"
                        android:tint="@color/red_ecom" />

                    <in.ecomexpress.sruti.utils.fonts.CustomTextRegular

                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:gravity="center"
                        android:text="Pending"
                        android:textColor="@color/black"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/fuel_recycler_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/colorBackground"
                android:elevation="@dimen/_20DP"
                android:padding="@dimen/_5DP" />


        </LinearLayout>
        <!--<android.support.v4.widget.ContentLoadingProgressBar
            android:id="@+id/address_looking_up"
            style="?android:attr/progressBarStyleLarge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="@{viewModel.isLoading ? View.VISIBLE : View.GONE}" />
-->
        <TextView
            android:id="@+id/textViewNoData"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="No data found."
            android:visibility="gone" />
    </FrameLayout>
</layout>