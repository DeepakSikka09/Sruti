<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:context=".ui.dashboard.globalscan.GlobalScanScreenActivity">

    <data>

        <import type="android.view.View" />

        <variable
            name="viewModel"
            type="in.ecomexpress.sruti.ui.dashboard.seller.seller_activity_model.SellerScanViewModel" />
    </data>

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">


        <com.journeyapps.barcodescanner.DecoratedBarcodeView
            android:id="@+id/zxing_barcode_scanner"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_400DP"
            app:zxing_scanner_layout="@layout/custom_scanner_view" />

        <ImageButton
            android:id="@+id/flashlight_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/flashoff"
            android:visibility="gone"
            android:layout_alignParentEnd="true"
            android:layout_marginEnd="@dimen/_15DP"
            android:layout_marginTop="@dimen/_16DP"
            android:background="?attr/selectableItemBackgroundBorderless" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_above="@+id/lv_back"
            android:layout_below="@+id/zxing_barcode_scanner"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/warning"
                android:layout_width="@dimen/_50DP"
                android:layout_height="@dimen/_50DP"
                android:layout_margin="@dimen/_10DP"
                android:background="@null"
                android:gravity="end"
                android:visibility="gone"
                android:layout_gravity="end"
                android:padding="@dimen/_5DP"
                app:srcCompat="@drawable/ic_red_warning"
                tools:ignore="VectorDrawableCompat" />
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/vendor_recycler_data"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

        </LinearLayout>


        <LinearLayout
            android:id="@+id/lv_back"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_margin="@dimen/_10DP"
            android:layout_marginBottom="@dimen/_10DP"
            android:background="@drawable/generic_button"
            android:onClick="@{() -> viewModel.onBack()}"
            android:orientation="horizontal"
            android:weightSum="2">


            <Button
                style="@style/TextStyle.Title.Sub"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginLeft="@dimen/_60DP"
                android:layout_weight="1.6"
                android:background="@null"
                android:gravity="center"
                android:onClick="@{() -> viewModel.onBack()}"
                android:text="@string/back"
                android:textColor="@color/colorBackground"
                android:textSize="15sp"
                android:textStyle="bold" />


            <TextView
                android:id="@+id/tv_awb_count"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginBottom="@dimen/_10DP"
                android:layout_marginTop="@dimen/_10DP"
                android:layout_weight="0.3"
                android:background="@drawable/circle"
                android:gravity="center"
                android:text="1000"
                android:textColor="@color/colorBackground"
                android:textSize="15sp"
                android:textStyle="bold"
                android:visibility="gone" />

        </LinearLayout>

    </RelativeLayout>

</layout>