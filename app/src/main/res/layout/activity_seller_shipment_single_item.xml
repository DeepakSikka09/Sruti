<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.cardview.widget.CardView
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/_10DP"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="@dimen/_7DP"
        app:cardElevation="@dimen/_10DP">

        <LinearLayout
            android:id="@+id/shipment_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/_5DP"
            android:background="@color/white"
            android:orientation="horizontal"
            android:padding="@dimen/_5DP">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/awb"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/_5DP"
                    android:orientation="horizontal">

                    <in.ecomexpress.sruti.utils.fonts.CustomTextBold

                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="start"
                        android:gravity="start"
                        android:text="@string/awb_no"
                        android:textColor="@color/colorText"
                        android:textSize="13sp" />

                    <in.ecomexpress.sruti.utils.fonts.CustomTextRegular
                        android:id="@+id/Distance"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="start"
                        android:gravity="start"
                        android:text="@{ viewModel.Airwaybill}"
                        android:textColor="@color/colorText"
                        android:textSize="12sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/order"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/_5DP"
                    android:orientation="horizontal">

                    <in.ecomexpress.sruti.utils.fonts.CustomTextBold

                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="start"
                        android:gravity="start"
                        android:text="ORDER NO : "
                        android:textColor="@color/colorText"
                        android:textSize="13sp" />

                    <in.ecomexpress.sruti.utils.fonts.CustomTextRegular
                        android:id="@+id/odr"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="start"
                        android:gravity="start"
                        android:text="@{ viewModel.OrderNo}"
                        android:textColor="@color/colorText"
                        android:textSize="12sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/mps_cell"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/_5DP"
                    android:orientation="horizontal">

                    <in.ecomexpress.sruti.utils.fonts.CustomTextBold

                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="start"
                        android:gravity="start"
                        android:text="Master AWB: "
                        android:textColor="@color/colorText"
                        android:textSize="13sp" />

                    <in.ecomexpress.sruti.utils.fonts.CustomTextRegular
                        android:id="@+id/mps_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="start"
                        android:gravity="start"
                        android:text="@{ viewModel.MasterNo}"
                        android:textColor="@color/colorText"
                        android:textSize="12sp" />
                </LinearLayout>


                <in.ecomexpress.sruti.utils.fonts.CustomTextRegular
                    android:id="@+id/status_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_2DP"
                    android:layout_marginBottom="@dimen/_2DP"
                    android:textColor="@color/colorText"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="end"
                android:layout_marginEnd="@dimen/_10DP"
                android:layout_marginRight="@dimen/_10DP"
                android:gravity="end"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/mps"
                    android:layout_width="@dimen/_50DP"
                    android:layout_height="@dimen/_50DP"
                    android:layout_gravity="center"
                    android:layout_marginLeft="10dp"
                    app:srcCompat="@drawable/ic_letter_m" />

                <CheckBox
                    android:id="@+id/checkbox_ckb"
                    android:layout_width="@dimen/_50DP"
                    android:layout_height="@dimen/_50DP"
                    android:layout_gravity="center"
                    android:buttonTint="@color/colorPrimaryDark" />

            </LinearLayout>
        </LinearLayout>

    </androidx.cardview.widget.CardView>


    <data>

        <variable
            name="viewModel"
            type="in.ecomexpress.sruti.ui.dashboard.seller.seller_activity_model.SellerShipmentItemViewModel" />

    </data>

</layout>